# Public Fudan aTrust / UIS preset, shared by all desktop release packages.
# Desktop: open Clash Verge Rev, launch FDU Connect, and enable campus access.
# The GUI creates its own config and rules, detects Clash's ports, and starts UIS login.
# Standalone CLI: copy to config.toml and run with -config config.toml.
# Complete UIS login in the browser on Windows, or follow the terminal prompts elsewhere.
# Set your application's proxy to the local SOCKS5 or HTTP address below.
# Optional Clash selective routing is disabled until its prerequisites are configured.
# CLI defaults and the ZJU_CONNECT_ environment variable prefix remain unchanged.
protocol = "atrust" # "easyconnect" or "atrust"
server_address = "vpn.fudan.edu.cn"
server_port = 443
username = "" # UIS OAuth2 uses the browser login flow, not these password fields.
password = ""
disable_zju_config = true # Only affects EasyConnect.
disable_remote_dns = false
socks_bind = "127.0.0.1:1080"
socks_user = ""
socks_passwd = ""
http_bind = "127.0.0.1:1081"
shadowsocks_url = "" # "ss://aes-128-gcm:password@:1082"
dial_direct_proxy = "" # "http://127.0.0.1:7890" or "socks://127.0.0.1:7890"
tcp_tunnel_mode = false
tun_mode = false # Standalone proxy mode does not create a system TUN adapter.
add_route = false
dns_ttl = 3600
disable_keep_alive = false
keep_alive_url = "" # "https://www.cnki.net/favicon.ico"
remote_dns_server = "auto"
secondary_dns_server = "auto"
dns_server_bind = "" # Optional UDP DNS listener in ordinary mode; leave empty for selective routing.
local_dns_server = "" # DNS used to resolve the VPN server, e.g. "223.5.5.5" or "223.5.5.5:53"
dns_hijack = false
fake_ip = false
debug_dump = false
debug_pcap_file = "" # Reconstruct encrypted VPN underlay TCP traffic in this PCAP file (debug only)
debug_tls_log_file = "" # Export TLS session secrets in NSS key log format (debug only)
bind_interface = "" # Leave empty for automatic selection; a manually set name overrides auto-detection.
auto_detect_interface = true # Automatically choose the physical network interface, including with Clash TUN enabled.

# Port forwarding
# The addresses below are documentation examples; replace them with allowed resources.
port_forwarding = [
#    { network_type = "tcp", bind_address = "127.0.0.1:9898", remote_address = "192.0.2.10:22" }
]

custom_dns = [
#    { host_name = "host.internal.example", ip = "192.0.2.10" }
]


# EasyConnect specific settings
totp_secret = ""
cert_file = ""
cert_password = ""
disable_server_config = false
skip_domain_resource = false
disable_multi_line = false
proxy_all = false
custom_proxy_domain = [
#    "science.org",
#    "nature.com"
]
twf_id = ""


# aTrust specific settings
auth_type = "auth/httpsOauth2"
login_domain = "id.fudan.edu.cn"
client_data_file = "client_data.json"
graph_code_file = "" # Optional: captcha image will open in browser if this left empty. If set, the program will save the captcha image to this file and ask user to input the code in terminal.
cas_ticket = ""
oauth2_code = ""
phone = ""
update_best_nodes_interval = 300
session_refresh_interval = 1800 # aTrust authConfig refresh interval in seconds; 0 disables
sid = ""
device_id = ""
sign_key = ""
resource_file = ""

# Optional selective routing. See the routing section in README.md / README_en.md.
# Before enabling: configure a dedicated local Clash SOCKS5 listener for Internet traffic,
# fill upstream_proxy below, and set auto_detect_interface = true or bind_interface above.
# Keep tun_mode, add_route, dns_hijack, fake_ip and dns_server_bind disabled/empty.
# Example destinations for selective routing; keep only the resources you need.
[routing]
enabled = false
# Exact ASCII hostnames, without scheme, path or port.
domains = [
    "ehall.fudan.edu.cn",
    "gsportal.fudan.edu.cn",
    "icourse.fudan.edu.cn",
    "libdbnav.fudan.edu.cn",
    "library.fudan.edu.cn",
    "visa.fudan.edu.cn",
    "pilot.studyblockchain.space"
]
domain_suffixes = ["fdu.edu.cn"] # Includes the suffix itself and its subdomains.
# IPv4 CIDRs; use /32 for a single host.
ip_cidrs = [
    "10.0.0.0/8",
    "175.186.248.18/32",
    "175.186.248.2/32",
    "175.186.248.53/32",
    "202.120.224.6/32"
]
upstream_proxy = "" # Required when enabled: socks5://loopback-IP:port of your dedicated Clash listener, never GLOBAL/FDU.
rules_file = "" # Optional existing JSON rules file; use the manager's actual path. Replaces the three inline lists.
